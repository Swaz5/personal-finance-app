# Placeholders only. Copy to .env for your own values; .env is gitignored.
# Nothing in the app loads .env automatically yet — set these in your shell.

# Use the synthetic demo database instead of data/finance.db.
# `python api/demo.py` sets this for you.
FINANCE_DEMO=0

# Optional: point at a specific SQLite file (tests use this).
FINANCE_DB_PATH=

# Planned integrations (not wired up yet):
# Fernet key for encrypting stored access tokens.
TOKEN_ENCRYPTION_KEY=your-fernet-key-here
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key
SIMPLEFIN_ACCESS_URL=https://user:pass@example.invalid/simplefin

# Only if you swap the local Ollama categorizer for the Anthropic API —
# transaction descriptions would then leave your machine.
ANTHROPIC_API_KEY=your-anthropic-api-key
